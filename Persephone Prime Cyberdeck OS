class AuditChain:
    """
    Tamper-Evident Memory - Immutable and Verified v1.1.0 (v2.1.0 merged).
    """

    def __init__(self, path: Path = None):
        Config.ensure_directories()
        self.path = path or (Config.LOGSDIR / "audit_chain.jsonl")
        self.last_hash = "GENESIS"
        self.lock = threading.Lock()
        self.bootstrap_from_disk()

    def bootstrap_from_disk(self):
        if not self.path.exists():
            return
        try:
            with open(self.path, "rb") as f:
                f.seek(0, os.SEEK_END)
                if f.tell() == 0:
                    return
                pos = f.tell() - 1
                while pos > 0:
                    f.seek(pos)
                    char = f.read(1)
                    if char == b"\n":
                        break
                    pos -= 1
                last_line = f.readline().decode().strip()
                if last_line:
                    last_entry = json.loads(last_line)
                    if "hash" in last_entry:
                        self.last_hash = last_entry["hash"]
        except Exception:
            self.last_hash = "GENESIS"

    def append(self, event_type: str, data: Dict) -> str:
        with self.lock:
            entry = {
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "type": event_type,
                "data": data,
                "prev_hash": self.last_hash,
            }
            payload = json.dumps(entry, sort_keys=True)
            current_hash = hashlib.sha256(payload.encode()).hexdigest()
            full_entry = {**entry, "hash": current_hash}
            with open(self.path, "a", encoding="utf-8") as f:
                f.write(json.dumps(full_entry) + "\n")
            self.last_hash = current_hash
            return current_hash


