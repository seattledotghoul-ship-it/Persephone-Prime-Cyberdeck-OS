@app.websocket("/ws/{client_id}")
async def websocket_endpoint(websocket: WebSocket, client_id: str):
    await connection_manager.connect(websocket)
    persephone.audit.append("WS_CONNECT", {"client_id": client_id})
    try:
        await websocket.send_text(
            f"Persephone Prime v{Config.VERSION} online. "
            f"Client {client_id}, the kiln hears you."
        )
        while True:
            data = await websocket.receive_text()
            result = await persephone.decide_and_act(
                text=data, user_id=client_id, username=client_id, channel="websocket"
            )
            response_text = result.get("response", "")
            await websocket.send_text(response_text)
    except WebSocketDisconnect:
        await connection_manager.disconnect(websocket)
        persephone.audit.append("WS_DISCONNECT", {"client_id": client_id})
    except Exception as e:
        await connection_manager.disconnect(websocket)
        persephone.audit.append("WS_ERROR", {"client_id": client_id, "error": str(e)})


