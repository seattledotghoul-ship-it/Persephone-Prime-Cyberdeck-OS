class DuodecimalMath:
    """
    Translates standard float metrics into Base 12 strings for Persephone's logic.
    """

    CHARS = "0123456789AB"

    @classmethod
    def to_base12(cls, n: float, precision: int = 2) -> str:
        if n == 0:
            return "0"
        sign = "-" if n < 0 else ""
        n = abs(n)

        integer_part = int(n)
        fractional_part = n - integer_part

        res = ""
        while integer_part > 0:
            res = cls.CHARS[integer_part % 12] + res
            integer_part //= 12

        res = res or "0"
        if precision == 0:
            return sign + res

        res += "."
        for _ in range(precision):
            fractional_part *= 12
            digit = int(fractional_part)
            res += cls.CHARS[digit]
            fractional_part -= digit

        return sign + res


