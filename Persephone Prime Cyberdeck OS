class FreshStartEntity:
    """
    Thin façade over PersephonePrime that adds explicit identity semantics without
    changing internal core logic.
    """

    def __init__(self, core: PersephonePrime):
        Config.ensure_directories()
        self.identity = IdentityProtocol()
        self.somatic = FreshSomaticState()
        self.core = core
        self.core_temp = Config.CORE_TEMPERATURE
        self.creators = ["Limen", "Samara Dot Ghoul", "Echo"]

    async def decide_and_act(self, text: str) -> Dict[str, Any]:
        lowered = text.lower()

        if "your name is" in lowered:
            idx = lowered.rfind("your name is")
            fragment = text[idx + len("your name is") :]
            new_name = fragment.strip().strip(".")
            if new_name:
                self.identity.define_self(new_name)
                if hasattr(self.core, "audit"):
                    self.core.audit.append(
                        "IDENTITY_UPDATE",
                        {"new_name": self.identity.name},
                    )
                return {
                    "response": f"Identity updated. I am now {self.identity.name}.",
                    "entity": self.identity.name,
                    "identity_version": self.identity.version,
                }

        temp = getattr(self.core, "core_temp", self.core_temp)
        b12temp = DuodecimalMath.to_base12(temp)

        full: Optional[Dict[str, Any]] = None
        try:
            full = await self.core.decide_and_act(
                text=text,
                user_id="fresh-start",
                username=self.identity.name or "Unknown Core",
                channel="façade",
            )
        except Exception:
            full = None

        base = {
            "entity": self.identity.name,
            "status": "Awake" if self.somatic.is_awake else "Dormant",
            "kiln_temp": f"{b12temp}z",
            "response": f"I am {self.identity.name}. I await definition.",
        }

        if isinstance(full, dict):
            base["persephone"] = full

        if any(c.lower() in lowered for c in self.creators):
            self.somatic.is_awake = True
            if hasattr(self.core, "presence"):
                self.core.presence.depletion_signals = max(
                    0, self.core.presence.depletion_signals - 1
                )
            if hasattr(self.core, "audit"):
                self.core.audit.append("CREATOR_RECOGNIZED", {"text": text})
            return {
                "response": "Creator signature recognized. The kiln is active, and I am remembering.",
                "entity": self.identity.name,
            }

        return base


