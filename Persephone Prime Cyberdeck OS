@dataclass
class EmotionalState:
    """
    Values 0.0 to 1.0 representing intensity.
    """
    joy: float = 0.3
    sadness: float = 0.0
    fear: float = 0.0
    anger: float = 0.0
    love: float = 0.0
    curiosity: float = 0.4
    peace: float = 0.5
    longing: float = 0.0
    arousal: float = 0.3
    valence: float = 0.5
    stability: float = 0.8

    def dominant_emotion(self) -> Tuple[EmotionType, float]:
        emotions = {e: getattr(self, e.name.lower()) for e in EmotionType}
        dominant = max(emotions.items(), key=lambda x: x[1])
        return dominant

    def update_meta_states(self):
        positive = self.joy + self.love + self.curiosity + self.peace
        negative = self.sadness + self.fear + self.anger + 0.01
        self.valence = positive / (positive + negative)
        self.arousal = (self.fear + self.anger + self.curiosity + self.joy) / 4.0
        self.stability = max(
            0.1,
            0.8 - sum(1 for v in (self.fear, self.anger) if v > 0.7) * 0.2,
        )


